{
  "name": "authforge",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant authentication platform",
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "lint": "eslint .",
    "start:api": "tsx src/api/server.ts",
    "start:worker": "tsx src/worker/main.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
