{
  "name": "authforge",
  "version": "0.1.0",
  "private": true,
  "description": "Temporary AWS authentication showcase for a developer console, API keys, and application sessions",
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "lint": "eslint .",
    "migrate": "tsx src/platform/database/migrate.ts",
    "start:api": "tsx src/api/server.ts",
    "start:worker": "tsx src/worker/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:integration": "AUTHFORGE_LOCAL_INTEGRATION=true vitest run tests/integration",
    "demo:check": "tsx scripts/demo-smoke.ts",
    "infra:check": "bash scripts/infra-check.sh",
    "aws:migrate": "tsx scripts/aws-migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-ses": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1113.0",
    "argon2": "^0.45.1",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.0.5"
  }
}
