NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
CONSOLE_ACCESS_CODE=replace-with-a-long-local-demo-code
CREDENTIAL_HASH_KEY=replace-with-at-least-32-random-characters
CONSOLE_ORIGIN=http://127.0.0.1:8080
DEFAULT_SESSION_TTL_SECONDS=900
MAX_SESSION_TTL_SECONDS=3600
MAX_SUBJECT_LENGTH=128
MAX_API_KEYS=100
MAX_SESSIONS=1000
MAX_CONSOLE_SESSIONS=20
SECURE_COOKIES=false
DATABASE_URL=postgres://authforge:authforge@localhost:5432/authforge
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
AWS_SQS_ENDPOINT_URL=
SHOWCASE_QUEUE_URL=
SHOWCASE_S3_BUCKET=
SHOWCASE_S3_KMS_KEY_ID=
SHOWCASE_SES_FROM_EMAIL=
SHOWCASE_SES_SIMULATOR_EMAIL=
POSTGRES_PORT=5432
REDIS_PORT=6379
MAX_REQUEST_BODY_BYTES=16384
MAX_FAILED_CONSOLE_ATTEMPTS=5
CONSOLE_ATTEMPT_WINDOW_SECONDS=60
MAX_DEMO_USERS=100
MAX_USER_SESSIONS=100
TRUST_PROXY=false
AWS_S3_ENDPOINT_URL=
AWS_SES_ENDPOINT_URL=
