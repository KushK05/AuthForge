NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
CONSOLE_ACCESS_CODE=replace-with-a-long-local-demo-code
CREDENTIAL_HASH_KEY=replace-with-at-least-32-random-characters
