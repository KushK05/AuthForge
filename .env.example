DEFAULT_SESSION_TTL_SECONDS=900
MAX_SESSION_TTL_SECONDS=3600
MAX_SUBJECT_LENGTH=128
MAX_API_KEYS=100
MAX_SESSIONS=1000
MAX_CONSOLE_SESSIONS=20
SECURE_COOKIES=false
DATABASE_URL=postgres://authforge:authforge@localhost:5432/authforge
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
SHOWCASE_QUEUE_URL=
SHOWCASE_S3_BUCKET=
SHOWCASE_S3_KMS_KEY_ID=
SHOWCASE_SES_FROM_EMAIL=
SHOWCASE_SES_SIMULATOR_EMAIL=
API_KEY_HASH_KEY=
TOKEN_DERIVATION_KEY=
SQS_EMAIL_QUEUE_URL=
AWS_SQS_ENDPOINT_URL=
KMS_JWT_SIGNING_KEY_ID=
AWS_KMS_ENDPOINT_URL=
PUBLIC_ISSUER_BASE_URL=http://localhost:8080
PASSWORD_MIN_LENGTH=12
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
POSTGRES_PORT=5432
REDIS_PORT=6379
